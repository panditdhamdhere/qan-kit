{
  "name": "qan-kit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false --noEmit",
    "test": "vitest run",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "format": "prettier --write .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
